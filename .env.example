# =============================================================================
# SUOXI Skin Care & Aesthetic Center ERP — Local Development Environment Template
# Copy to `.env` for local development (never commit `.env` with real secrets)
# =============================================================================

NODE_ENV=development
PORT=3000
TZ="Asia/Dhaka"
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"
TRUST_PROXY=1

# PostgreSQL 16 (docker-compose.yml maps localhost:5432 -> postgres container)
DATABASE_URL="postgresql://suoxi_app:CHANGE_DEV_PASSWORD@127.0.0.1:5432/suoxi_crm"
PG_POOL_MAX=10

# Redis 7 (docker-compose.yml maps localhost:6379 -> redis container)
REDIS_URL="redis://:CHANGE_DEV_REDIS_PASSWORD@127.0.0.1:6379/0"

# Security Keys (Generate with: openssl rand -hex 32)
SESSION_SECRET="REPLACE_WITH_64_CHAR_HEX_SESSION_SECRET"
APP_MASTER_KEY="REPLACE_WITH_64_CHAR_HEX_MASTER_KEY"
PAYMENT_WEBHOOK_SECRET="REPLACE_WITH_64_CHAR_HEX_WEBHOOK_SECRET"
COOKIE_SECURE="false"
ENABLE_DEMO_ROLE_SWITCHER="false"

# Private File Uploads
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB=15

# External Integrations (Configure via environment or encrypted DB settings)
SMS_GATEWAY_API_KEY=""
SMS_SENDER_ID="SUOXI"
SMTP_HOST="mail.suoxi.tech"
SMTP_PORT=465
SMTP_USER="care@suoxi.tech"
SMTP_PASS=""
SMTP_FROM="care@suoxi.tech"
