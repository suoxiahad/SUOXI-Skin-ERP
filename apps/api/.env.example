# SUOXI ERP — Workspace API Environment Configuration Template (PostgreSQL ONLY)
# Replace all placeholders before running in staging or production.

PORT=3101
NODE_ENV=development
TZ=Asia/Dhaka

# PostgreSQL 16 Connection URL (docker-compose.yml maps localhost:5432)
DATABASE_URL=postgresql://suoxi_app:CHANGE_DEV_PASSWORD@127.0.0.1:5432/suoxi_crm

# Redis 7 Connection URL
REDIS_URL=redis://:CHANGE_DEV_REDIS_PASSWORD@127.0.0.1:6379/0

# Cryptographic secrets (generate with `openssl rand -hex 32`)
SESSION_SECRET=REPLACE_WITH_64_CHAR_HEX_SESSION_SECRET
APP_MASTER_KEY=REPLACE_WITH_64_CHAR_HEX_MASTER_KEY
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_64_CHAR_HEX_WEBHOOK_SECRET
SMS_WEBHOOK_SECRET=REPLACE_WITH_64_CHAR_HEX_SMS_WEBHOOK_SECRET

# External Gateways (configure via secret manager / server env)
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=SUOXI
