# SUOXI CRM — Backend API Environment Configuration Template
# DEV-ONLY CREDENTIALS: Must be replaced with secure vault secrets in production environments.

# API Server Port (Default isolated workspace port is 3001)
PORT=3001
NODE_ENV=development

# MySQL 8 Connection URL (Mapped to host port 3308 via docker-compose.yml)
# Format: mysql://<user>:<password>@localhost:3308/<database>
DATABASE_URL=mysql://suoxi_dev_user:suoxi_dev_password_only@localhost:3308/suoxi_crm

# JWT Secret for access tokens (Dev-only placeholder)
JWT_SECRET=suoxi_dev_only_jwt_secret_must_be_min_32_chars_long

# SMS Gateway credentials (Dev-only placeholder)
SMS_GATEWAY_API_KEY=suoxi_dev_mock_sms_gateway_key
SMS_GATEWAY_SENDER_ID=SUOXI
