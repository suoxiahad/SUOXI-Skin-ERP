{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@suoxi/shared-types": [
        "../../packages/shared-types/src/index.ts"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src/**/*"
  ]
}
