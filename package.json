{
  "name": "suoxi-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "dev:api": "npm --prefix apps/api run start",
    "dev:web": "npm --prefix apps/web run dev -- --port 3000",
    "dev:worker": "tsx server/worker.ts",
    "worker": "tsx server/worker.ts",
    "build": "vite build",
    "build:web": "npm --prefix apps/web run build",
    "lint": "tsc --noEmit",
    "typecheck": "npm --prefix packages/shared-types run typecheck && npm --prefix apps/web run typecheck && npm --prefix apps/worker run typecheck && npm --prefix apps/api run typecheck",
    "test:api": "npm --prefix apps/api run test",
    "test:pg": "tsx server/__tests__/productionReadiness.test.ts",
    "pg:migrate": "tsx server/db/migrate.ts",
    "pg:status": "tsx server/db/migrate.ts --status",
    "pg:create-admin": "tsx server/db/createAdmin.ts",
    "pg:seed": "tsx server/db/seedDefaults.ts",
    "pg:import-patients": "tsx server/db/importPatients.ts",
    "migrate:plan": "npm --prefix apps/api run migrate:plan",
    "migrate:up": "npm --prefix apps/api run migrate:up"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "argon2": "^0.45.1",
    "bullmq": "^6.7.8",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.546.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.11.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "zod": "^3.24.2"
  }
}
